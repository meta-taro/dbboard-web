# Node.js / pnpm 関連
node_modules/
.pnpm-store/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# npm / yarn は使用禁止だが、誤って生成された場合の防御
package-lock.json
yarn.lock

# ビルド成果物
dist/
build/
out/
.output/
.nitro/
.nuxt/
.cache/
coverage/
*.tsbuildinfo

# 環境変数（.env.example のみコミット）
.env
.env.*
!.env.example

# ローカル DB / シークレット類
*.sqlite
*.sqlite3
*.db
*.pem
*.key

# IDE / エディタ設定
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.swp
*.swo

# OS メタデータ
.DS_Store
Thumbs.db
desktop.ini

# テスト・E2E アーティファクト
playwright-report/
test-results/
blob-report/
storybook-static/

# Claude Code / AI エージェントの一時ファイル
.claude/cache/
.claude/tmp/

# Claude Code のローカル許可設定（個人ごとに異なるためコミット対象外）
.claude/settings.local.json

# ローカル秘密控え（🟡 識別子のみ・🔴 token/key は置かない）— commit 禁止
SECRETS.local.md

# pii-scan の denylist（実名・実アドレスそのもの）。これを commit したら
# スキャナが隠している当の文字列を tracked file に戻すことになる。
# 雛形は .pii-denylist.example、CI では PII_DENYLIST secret から生成する。
.pii-denylist

# 司令塔のベースルール正本と共通雛形（個人名を含むため OSS 上流に出さない）。
# 実体は司令塔リポから配布される。
/.claude/rules/
/.claude/templates/
