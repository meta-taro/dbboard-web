# dbboard-web environment variables.
# Copy to .env at the repo root and fill in. The .env file is gitignored.

# ── apps/api (NestJS) ─────────────────────────────────────────────────────
PORT=4000

# Loopback bind by default — issue 0016. Set to 0.0.0.0 only when you have
# also set DBBOARD_API_SECRET (the API refuses to start otherwise) and have
# a reverse proxy with TLS in front (see docs/deployment.md).
DBBOARD_BIND_HOST=127.0.0.1

# Shared bearer secret guarding every route except GET /health. Generate
# with `openssl rand -base64 48`. The Nuxt server proxy reads NUXT_API_SECRET
# below and injects this value as `Authorization: Bearer …` on every
# upstream call, so set both to the same string. Empty disables auth (only
# safe when DBBOARD_BIND_HOST is loopback).
DBBOARD_API_SECRET=

# ── Postgres adapter (issue 0004) ──────────────────────────────────────────
# Convenience URL for a Postgres-wire backend used during local dev. The
# API does not auto-connect at boot — clients register a connection via
# POST /connections and may pass `connectionString` or split
# host/port/db/user/password fields. TLS is required unless you say
# otherwise: an unqualified URL resolves to `sslmode=require`, and only
# an explicit `sslmode=disable` turns it off. A local container with TLS
# unconfigured is exactly that case, so the dev URL below carries the
# opt-out. See apps/api/README.md for the curl quickstart.
# DATABASE_URL=postgresql://postgres:dev@localhost:5432/postgres?sslmode=disable

# ── apps/web (Nuxt) ────────────────────────────────────────────────────────
# Same-origin proxy path the browser hits — composables call
# `${apiBaseUrl}/<endpoint>`. The Nuxt server then forwards to apiUpstream
# with the bearer secret. The secret never reaches the browser bundle.
NUXT_PUBLIC_API_BASE_URL=/api/proxy

# Server-only (no NUXT_PUBLIC_ prefix) — the proxy reads these to reach
# the upstream NestJS API and inject `Authorization: Bearer …`. Mirror
# NUXT_API_SECRET to DBBOARD_API_SECRET.
NUXT_API_UPSTREAM=http://localhost:4000
NUXT_API_SECRET=

# ── Optional: AI providers (Phase 6) ───────────────────────────────────────
# AI is opt-in. With none of the variables below set, the registry holds no
# provider, every /ai route answers 404 ai_disabled, the Nuxt panel renders a
# neutral "not configured" notice, and core DB flows are untouched.
#
# The simple case — one Anthropic provider. These two names mirror the
# desktop client's env block so a single .env covers both, and they keep
# working exactly as before: the key alone yields a one-provider deployment
# whose id is "anthropic". Default model: claude-sonnet-4-6.
# DBBOARD_ANTHROPIC_API_KEY=
# DBBOARD_ANTHROPIC_MODEL=claude-sonnet-4-6
#
# More than one provider — desktop stores this list in ai-providers.toml
# beside the OS keychain; a server has no keychain and must not accept a key
# over HTTP (baseline §15), so the list is env-only and the operator owns it.
#
# Name each provider in DBBOARD_AI_PROVIDERS, then give it a block whose
# suffix is the id uppercased with hyphens turned into underscores. Ids are
# lowercase letters, digits and hyphens only. _KIND and _API_KEY are
# required; _MODEL and _NAME fall back to the kind's default model and to
# the id itself. Known kinds: anthropic.
# DBBOARD_AI_PROVIDERS=fast,deep
# DBBOARD_AI_FAST_KIND=anthropic
# DBBOARD_AI_FAST_API_KEY=
# DBBOARD_AI_FAST_MODEL=claude-sonnet-4-6
# DBBOARD_AI_FAST_NAME=Fast
# DBBOARD_AI_DEEP_KIND=anthropic
# DBBOARD_AI_DEEP_API_KEY=
# DBBOARD_AI_DEEP_MODEL=claude-opus-4-8
# DBBOARD_AI_DEEP_NAME=Deep
#
# Which one answers a request that names none. Defaults to the first entry,
# and DBBOARD_ANTHROPIC_API_KEY always yields the first entry — so adding a
# list to an existing deployment keeps the default it had yesterday. Naming
# a provider that is not configured fails the boot rather than falling back.
# DBBOARD_AI_DEFAULT=deep
