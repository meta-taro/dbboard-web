{
  "name": "@dbboard-web/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS HTTP API for dbboard-web. Implements docs/api-contract.md.",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "dev": "node --env-file-if-exists=../../.env node_modules/@nestjs/cli/bin/nest.js start --watch",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "conformance": "vitest run --config vitest.conformance.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@libsql/client": "^0.17.4",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "mysql2": "^3.23.2",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ssh2": "1.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "1.13.5",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.20.0",
    "@types/ssh2": "1.15.5",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "supertest": "^7.0.0",
    "testcontainers": "^12.0.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "1.5.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.0"
  }
}
