# dbboard-web environment variables.
# Copy to .env at the repo root and fill in. The .env file is gitignored.

# ── apps/api (NestJS) ─────────────────────────────────────────────────────
PORT=4000

# Loopback bind by default — issue 0016. Set to 0.0.0.0 only when you have
# also set DBBOARD_API_SECRET (the API refuses to start otherwise) and have
# a reverse proxy with TLS in front (see docs/deployment.md).
DBBOARD_BIND_HOST=127.0.0.1

# Shared bearer secret guarding every route except GET /health. Generate
# with `openssl rand -base64 48`. The Nuxt server proxy reads NUXT_API_SECRET
# below and injects this value as `Authorization: Bearer …` on every
# upstream call, so set both to the same string. Empty disables auth (only
# safe when DBBOARD_BIND_HOST is loopback).
DBBOARD_API_SECRET=

# ── Postgres adapter (issue 0004) ──────────────────────────────────────────
# Convenience URL for a Postgres-wire backend used during local dev. The
# API does not auto-connect at boot — clients register a connection via
# POST /connections and may pass `connectionString` or split
# host/port/db/user/password fields. `sslmode` is auto-upgraded to
# `require` for *.neon.tech / *.supabase.co; local dev typically needs no
# sslmode parameter. See apps/api/README.md for the curl quickstart.
# DATABASE_URL=postgresql://postgres:dev@localhost:5432/postgres

# ── apps/web (Nuxt) ────────────────────────────────────────────────────────
# Same-origin proxy path the browser hits — composables call
# `${apiBaseUrl}/<endpoint>`. The Nuxt server then forwards to apiUpstream
# with the bearer secret. The secret never reaches the browser bundle.
NUXT_PUBLIC_API_BASE_URL=/api/proxy

# Server-only (no NUXT_PUBLIC_ prefix) — the proxy reads these to reach
# the upstream NestJS API and inject `Authorization: Bearer …`. Mirror
# NUXT_API_SECRET to DBBOARD_API_SECRET.
NUXT_API_UPSTREAM=http://localhost:4000
NUXT_API_SECRET=

# ── Optional: AI provider (Phase 6) ────────────────────────────────────────
# AI is opt-in. Leave unset to keep the AI module disabled.
# AI_PROVIDER=openai
# OPENAI_API_KEY=
