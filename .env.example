# dbboard-web environment variables.
# Copy to .env at the repo root and fill in. The .env file is gitignored.

# ── apps/api (NestJS) ─────────────────────────────────────────────────────
PORT=4000
# Comma-separated origins permitted by CORS. Empty disables CORS.
CORS_ORIGINS=http://localhost:3000

# ── Postgres adapter (issue 0004) ──────────────────────────────────────────
# Connection URL for the Postgres-wire backend used by the API in dev.
# sslmode is upgraded to require if "prefer" is configured (per the contract).
# DATABASE_URL=postgresql://user:pass@localhost:5432/postgres?sslmode=require

# ── apps/web (Nuxt) ────────────────────────────────────────────────────────
# Base URL of the NestJS API as seen from the browser. Override per deployment.
NUXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ── Optional: AI provider (Phase 6) ────────────────────────────────────────
# AI is opt-in. Leave unset to keep the AI module disabled.
# AI_PROVIDER=openai
# OPENAI_API_KEY=
